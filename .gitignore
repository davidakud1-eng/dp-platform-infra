# =======================================================
# DP Terraform - Git Ignore Rules
# =======================================================

# Terraform local working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan

# Terraform crash logs
crash.log
crash.*.log

# Terraform CLI configuration
.terraformrc
terraform.rc

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# IDE / operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db